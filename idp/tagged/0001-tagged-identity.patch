+
+// subjectFor returns the OIDC subject: the grant-assigned subject for a tagged
+// node, otherwise the node's user id.
+func subjectFor(userID string, tagID *taggedIdentity) string {
+	if tagID != nil {
+		return tagID.Subject
+	}
+	return userID
+}
+
+// loginForLog names the caller for the token-issued log line.
+func loginForLog(who *apitype.WhoIsResponse, tagID *taggedIdentity) string {
+	if tagID != nil {
+		return "tagged:" + tagID.Subject
+	}
+	return who.UserProfile.LoginName
+}
