diff --git a/server/tagged_identity_test.go b/server/tagged_identity_test.go
new file mode 100644
index 0000000..a7396ba
--- /dev/null
+++ b/server/tagged_identity_test.go
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+package server
+
+import (
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+
+	"tailscale.com/client/tailscale/apitype"
+	"tailscale.com/tailcfg"
+)
+
+func taggedWho(t *testing.T, rules ...capRule) *apitype.WhoIsResponse {
+	t.Helper()
+	var raws []tailcfg.RawMessage
+	for _, r := range rules {
+		raws = append(raws, mustMarshalJSON(t, r))
+	}
+	return &apitype.WhoIsResponse{
+		Node:        &tailcfg.Node{ID: 7, Name: "laptop.example.ts.net.", User: 99, Tags: []string{"tag:probe"}},
+		UserProfile: &tailcfg.UserProfile{LoginName: "tagged-devices"},
+		CapMap:      tailcfg.PeerCapMap{tailcfg.PeerCapabilityTsIDP: raws},
+	}
+}
+
+func TestTaggedIdentityFor(t *testing.T) {
+	id := &taggedIdentity{Subject: "device-operator", Email: "op@example.com"}
+	user := &apitype.WhoIsResponse{Node: &tailcfg.Node{User: 1}, CapMap: tailcfg.PeerCapMap{
+		tailcfg.PeerCapabilityTsIDP: {mustMarshalJSON(t, capRule{TaggedIdentity: id})},
+	}}
+	tests := []struct {
+		name string
+		who  *apitype.WhoIsResponse
+		want *taggedIdentity
+	}{
+		{"nil who", nil, nil},
+		{"user-owned node ignores the grant", user, nil},
+		{"tagged without grant", taggedWho(t), nil},
+		{"tagged with other rule only", taggedWho(t, capRule{ExtraClaims: map[string]any{"a": "b"}}), nil},
+		{"tagged with empty subject", taggedWho(t, capRule{TaggedIdentity: &taggedIdentity{Email: "x@example.com"}}), nil},
+		{"tagged with identity", taggedWho(t, capRule{ExtraClaims: map[string]any{"a": "b"}}, capRule{TaggedIdentity: id}), id},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := taggedIdentityFor(tt.who)
+			if (got == nil) != (tt.want == nil) || (got != nil && *got != *tt.want) {
+				t.Fatalf("got %+v want %+v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestTaggedAuthorize(t *testing.T) {
+	for _, tt := range []struct {
+		name    string
+		who     *apitype.WhoIsResponse
+		wantErr bool
+	}{
+		{"refused without identity", taggedWho(t), true},
+		{"allowed with identity", taggedWho(t, capRule{TaggedIdentity: &taggedIdentity{Subject: "s"}}), false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			srv := setupTestServer(t, newTestWhoIsClient(t, tt.who, false))
+			srv.funnelClients["c"] = &FunnelClient{ID: "c", Secret: "s", Name: "c", RedirectURIs: []string{"https://rp.example.com/cb"}}
+			q := url.Values{"client_id": {"c"}, "redirect_uri": {"https://rp.example.com/cb"}, "state": {"st"}}
+			req := httptest.NewRequest("GET", "/authorize?"+q.Encode(), nil)
+			req.RemoteAddr = "127.0.0.1:12345"
+			rr := httptest.NewRecorder()
+			srv.serveAuthorize(rr, req)
+			if rr.Code != http.StatusFound {
+				t.Fatalf("code %d: %s", rr.Code, rr.Body.String())
+			}
+			loc, _ := url.Parse(rr.Header().Get("Location"))
+			if tt.wantErr != (loc.Query().Get("error") == ecAccessDenied) {
+				t.Fatalf("unexpected redirect %s", loc)
+			}
+			if !tt.wantErr && loc.Query().Get("code") == "" {
+				t.Fatal("no code issued")
+			}
+		})
+	}
+}
+
+func jwtClaims(t *testing.T, tok string) map[string]any {
+	t.Helper()
+	parts := strings.Split(tok, ".")
+	if len(parts) != 3 {
+		t.Fatalf("not a jwt")
+	}
+	b, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := map[string]any{}
+	if err := json.Unmarshal(b, &m); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func TestTaggedIssueTokensAndUserInfo(t *testing.T) {
+	id := &taggedIdentity{Subject: "device-operator", Email: "op@example.com", Name: "Operator"}
+	who := taggedWho(t, capRule{
+		IncludeInUserInfo: true,
+		ExtraClaims:       map[string]any{"flag_member": "true"},
+		TaggedIdentity:    id,
+	})
+	srv := setupTestServer(t, newTestWhoIsClient(t, who, false))
+	ar := &AuthRequest{RemoteUser: who, ClientID: "test-client", Scopes: []string{"openid", "email", "profile"}, Nonce: "n"}
+	rr := httptest.NewRecorder()
+	srv.issueTokens(rr, httptest.NewRequest("POST", "/token", nil), ar)
+	if rr.Code != http.StatusOK {
+		t.Fatalf("issueTokens %d: %s", rr.Code, rr.Body.String())
+	}
+	var resp struct {
+		IDToken     string `json:"id_token"`
+		AccessToken string `json:"access_token"`
+	}
+	if err := json.Unmarshal(rr.Body.Bytes(), &resp); err != nil {
+		t.Fatal(err)
+	}
+	c := jwtClaims(t, resp.IDToken)
+	if c["sub"] != "device-operator" || c["email"] != "op@example.com" || c["preferred_username"] != "op" || c["flag_member"] != "true" {
+		t.Fatalf("claims: %v", c)
+	}
+
+	srv.mu.Lock()
+	srv.accessToken[resp.AccessToken].ValidTill = time.Now().Add(time.Hour)
+	srv.mu.Unlock()
+	req := httptest.NewRequest("GET", "/userinfo", nil)
+	req.Header.Set("Authorization", "Bearer "+resp.AccessToken)
+	rr = httptest.NewRecorder()
+	srv.serveUserInfo(rr, req)
+	if rr.Code != http.StatusOK {
+		t.Fatalf("userinfo %d: %s", rr.Code, rr.Body.String())
+	}
+	u := map[string]any{}
+	_ = json.Unmarshal(rr.Body.Bytes(), &u)
+	if u["sub"] != "device-operator" || u["email"] != "op@example.com" || u["flag_member"] != "true" {
+		t.Fatalf("userinfo: %v", u)
+	}
+
+	// Without a grant identity the token endpoint still refuses.
+	bare := taggedWho(t)
+	rr = httptest.NewRecorder()
+	srv.issueTokens(rr, httptest.NewRequest("POST", "/token", nil), &AuthRequest{RemoteUser: bare, ClientID: "test-client"})
+	if rr.Code != http.StatusBadRequest {
+		t.Fatalf("bare tagged token: %d", rr.Code)
+	}
+}
