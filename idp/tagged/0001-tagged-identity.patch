@@ -27,6 +27,38 @@ type capRule struct {
 	// allow lists
 	AllowAdminUI bool `json:"allow_admin_ui"`
 	AllowDCR     bool `json:"allow_dcr"` // dynamic client registration
+
+	// TaggedIdentity supplies the subject, email and name for a tagged node,
+	// which has no user identity of its own. It is read only from the
+	// operator's grant (never from the caller) and is ignored for user-owned
+	// nodes. See taggedIdentityFor.
+	TaggedIdentity *taggedIdentity `json:"taggedIdentity,omitempty"`
+}
+
+// taggedIdentity is the identity a grant assigns to a tagged node.
+type taggedIdentity struct {
+	Subject string `json:"subject"`
+	Email   string `json:"email,omitempty"`
+	Name    string `json:"name,omitempty"`
+}
+
+// taggedIdentityFor returns the identity a grant assigns to the tagged caller
+// in who, or nil when no grant supplies a non-empty subject. A nil result
+// means the tagged node is refused, as upstream does without this option.
+func taggedIdentityFor(who *apitype.WhoIsResponse) *taggedIdentity {
+	if who == nil || who.Node == nil || !who.Node.IsTagged() {
+		return nil
+	}
+	rules, err := tailcfg.UnmarshalCapJSON[capRule](who.CapMap, tailcfg.PeerCapabilityTsIDP)
+	if err != nil {
+		return nil
+	}
+	for _, rule := range rules {
+		if id := rule.TaggedIdentity; id != nil && id.Subject != "" {
+			return id
+		}
+	}
+	return nil
 }
 
