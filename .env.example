# Copy to .env (untracked). Placeholders only; never commit real values.

# Tailnet (example.ts.net is a reserved-style placeholder).
TAILNET=example.ts.net
IDP_HOSTNAME=idp
# The IdP issuer as members see it.
OIDC_ISSUER=https://idp.example.ts.net

# tsidp node auth key lives in a FILE, never in env or argv.
TS_AUTHKEY_FILE=./secrets/tsidp-authkey

# Probe
ALLOWED_ORIGIN=https://app.example.org
PROBE_CAPABILITY=example.org/cap/flag-probe
PROBE_TAG=tag:flag-probe

# apps/kit
KIT_ORIGIN=https://kit.example.org
# Only requests arriving from this proxy address may carry serve headers.
TRUSTED_PROXY_ADDR=127.0.0.1
OIDC_CLIENT_ID=flags-kit
OIDC_REDIRECT_URI=https://kit.example.org/auth/callback
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-me
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CF_ACCESS_AUD=replace-me
FLAG_MEMBER_EMAILS=you@example.com

# ACL apply (stub): path to a file holding the API key, plus the tailnet.
ACL_API_KEY_FILE=./secrets/acl-api-key

# Denylist for scripts/denylist-check.sh: one token per line, UNTRACKED file,
# or set DENYLIST (newline-separated) in the environment.
DENYLIST_FILE=.denylist
